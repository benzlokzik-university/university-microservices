{
  "dataSources": [
    {
      "name": "Prometheus",
      "type": "prometheus",
      "url": "http://prometheus:9090",
      "access": "proxy",
      "isDefault": true,
      "jsonData": {
        "timeInterval": "15s",
        "httpMethod": "POST"
      }
    },
    {
      "name": "Loki",
      "type": "loki",
      "url": "http://loki:3100",
      "access": "proxy",
      "jsonData": {
        "maxLines": 1000
      }
    },
    {
      "name": "PostgreSQL - User Account",
      "type": "postgres",
      "url": "user-account-db:5432",
      "database": "user_account",
      "user": "postgres",
      "secureJsonData": {
        "password": "postgres"
      },
      "jsonData": {
        "sslmode": "disable"
      }
    },
    {
      "name": "PostgreSQL - Game Catalog",
      "type": "postgres",
      "url": "game-catalog-db:5432",
      "database": "game_catalog",
      "user": "postgres",
      "secureJsonData": {
        "password": "postgres"
      },
      "jsonData": {
        "sslmode": "disable"
      }
    },
    {
      "name": "PostgreSQL - Rent",
      "type": "postgres",
      "url": "rent-db:5432",
      "database": "rent",
      "user": "postgres",
      "secureJsonData": {
        "password": "postgres"
      },
      "jsonData": {
        "sslmode": "disable"
      }
    },
    {
      "name": "RabbitMQ",
      "type": "rabbitmq",
      "url": "http://rabbitmq:15672",
      "access": "proxy",
      "basicAuth": true,
      "basicAuthUser": "guest",
      "secureJsonData": {
        "basicAuthPassword": "guest"
      }
    }
  ],
  "services": [
    {
      "name": "gateway",
      "port": 8000,
      "container": "gateway-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "gateway",
          "type": "api-gateway"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/gateway/*.log",
        "format": "json"
      }
    },
    {
      "name": "user-account",
      "port": 8001,
      "container": "user-account-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "user-account",
          "type": "microservice",
          "database": "user-account-db"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/user-account/*.log",
        "format": "json"
      },
      "database": {
        "name": "user-account-db",
        "port": 5433,
        "metrics": {
          "queries": [
            "active_connections",
            "database_size",
            "table_sizes",
            "slow_queries"
          ]
        }
      }
    },
    {
      "name": "game-catalog",
      "port": 8002,
      "container": "game-catalog-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "game-catalog",
          "type": "microservice",
          "database": "game-catalog-db"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/game-catalog/*.log",
        "format": "json"
      },
      "database": {
        "name": "game-catalog-db",
        "port": 5434,
        "metrics": {
          "queries": [
            "active_connections",
            "database_size",
            "table_sizes",
            "slow_queries"
          ]
        }
      }
    },
    {
      "name": "booking",
      "port": 8003,
      "container": "booking-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "booking",
          "type": "microservice"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/booking/*.log",
        "format": "json"
      },
      "dependencies": [
        {
          "service": "user-account",
          "type": "http",
          "monitor": true
        }
      ]
    },
    {
      "name": "payment",
      "port": 8004,
      "container": "payment-service",
      "grpcPort": 50051,
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "payment",
          "type": "microservice"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/payment/*.log",
        "format": "json"
      },
      "grpc": {
        "enabled": true,
        "port": 50051,
        "metrics": {
          "requestDuration": true,
          "requestCount": true,
          "errorRate": true
        }
      }
    },
    {
      "name": "rent",
      "port": 8005,
      "container": "rent-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "rent",
          "type": "microservice",
          "database": "rent-db"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/rent/*.log",
        "format": "json"
      },
      "database": {
        "name": "rent-db",
        "port": 5435,
        "metrics": {
          "queries": [
            "active_connections",
            "database_size",
            "table_sizes",
            "slow_queries"
          ]
        }
      },
      "dependencies": [
        {
          "service": "payment",
          "type": "grpc",
          "monitor": true
        },
        {
          "service": "booking",
          "type": "http",
          "monitor": true
        },
        {
          "service": "game-catalog",
          "type": "http",
          "monitor": true
        },
        {
          "service": "user-account",
          "type": "http",
          "monitor": true
        }
      ]
    },
    {
      "name": "rating",
      "port": 8006,
      "container": "rating-service",
      "metrics": {
        "endpoint": "/metrics",
        "scrapeInterval": "15s",
        "labels": {
          "service": "rating",
          "type": "microservice"
        }
      },
      "healthCheck": {
        "endpoint": "/health",
        "interval": "30s"
      },
      "logs": {
        "path": "/var/log/rating/*.log",
        "format": "json"
      },
      "dependencies": [
        {
          "service": "game-catalog",
          "type": "http",
          "monitor": true
        }
      ]
    }
  ],
  "infrastructure": {
    "rabbitmq": {
      "name": "rabbitmq",
      "container": "rabbitmq",
      "managementPort": 15672,
      "amqpPort": 5672,
      "metrics": {
        "endpoint": "/api/metrics",
        "scrapeInterval": "30s",
        "monitors": [
          "queue_length",
          "message_rate",
          "connection_count",
          "channel_count",
          "consumer_count"
        ]
      }
    }
  },
  "dashboards": [
    {
      "name": "Microservices Overview",
      "panels": [
        {
          "title": "Service Health Status",
          "type": "stat",
          "targets": [
            {
              "expr": "up{job=\"microservices\"}",
              "legendFormat": "{{service}}"
            }
          ]
        },
        {
          "title": "Request Rate by Service",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(http_requests_total[5m])",
              "legendFormat": "{{service}} - {{method}}"
            }
          ]
        },
        {
          "title": "Response Time by Service",
          "type": "graph",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "{{service}} - p95"
            }
          ]
        },
        {
          "title": "Error Rate by Service",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
              "legendFormat": "{{service}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Database Performance",
      "panels": [
        {
          "title": "Database Connections",
          "type": "graph",
          "targets": [
            {
              "expr": "pg_stat_database_numbackends",
              "legendFormat": "{{database}}"
            }
          ]
        },
        {
          "title": "Database Size",
          "type": "graph",
          "targets": [
            {
              "expr": "pg_database_size_bytes",
              "legendFormat": "{{database}}"
            }
          ]
        },
        {
          "title": "Slow Queries",
          "type": "table",
          "targets": [
            {
              "expr": "pg_stat_statements_mean_exec_time",
              "legendFormat": "{{database}} - {{query}}"
            }
          ]
        }
      ]
    },
    {
      "name": "RabbitMQ Monitoring",
      "panels": [
        {
          "title": "Queue Length",
          "type": "graph",
          "targets": [
            {
              "expr": "rabbitmq_queue_messages",
              "legendFormat": "{{queue}}"
            }
          ]
        },
        {
          "title": "Message Rate",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(rabbitmq_queue_messages_published_total[5m])",
              "legendFormat": "{{queue}} - published"
            },
            {
              "expr": "rate(rabbitmq_queue_messages_delivered_total[5m])",
              "legendFormat": "{{queue}} - delivered"
            }
          ]
        },
        {
          "title": "Connection Count",
          "type": "stat",
          "targets": [
            {
              "expr": "rabbitmq_connections",
              "legendFormat": "Connections"
            }
          ]
        }
      ]
    },
    {
      "name": "Service Dependencies",
      "panels": [
        {
          "title": "HTTP Request Duration",
          "type": "graph",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(http_client_request_duration_seconds_bucket[5m]))",
              "legendFormat": "{{service}} -> {{target}}"
            }
          ]
        },
        {
          "title": "gRPC Request Duration",
          "type": "graph",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(grpc_client_request_duration_seconds_bucket[5m]))",
              "legendFormat": "{{service}} -> {{target}}"
            }
          ]
        },
        {
          "title": "Dependency Health",
          "type": "stat",
          "targets": [
            {
              "expr": "up{job=\"service-dependencies\"}",
              "legendFormat": "{{source}} -> {{target}}"
            }
          ]
        }
      ]
    }
  ],
  "alerts": [
    {
      "name": "Service Down",
      "condition": "up{job=\"microservices\"} == 0",
      "duration": "1m",
      "severity": "critical",
      "message": "Service {{service}} is down"
    },
    {
      "name": "High Error Rate",
      "condition": "rate(http_requests_total{status=~\"5..\"}[5m]) > 0.1",
      "duration": "5m",
      "severity": "warning",
      "message": "High error rate for service {{service}}"
    },
    {
      "name": "High Response Time",
      "condition": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) > 1",
      "duration": "5m",
      "severity": "warning",
      "message": "High response time for service {{service}}"
    },
    {
      "name": "Database Connection Pool Exhausted",
      "condition": "pg_stat_database_numbackends / pg_settings_max_connections > 0.8",
      "duration": "2m",
      "severity": "warning",
      "message": "Database {{database}} connection pool nearly exhausted"
    },
    {
      "name": "RabbitMQ Queue Backlog",
      "condition": "rabbitmq_queue_messages > 1000",
      "duration": "5m",
      "severity": "warning",
      "message": "Queue {{queue}} has high message backlog"
    },
    {
      "name": "Service Dependency Failure",
      "condition": "up{job=\"service-dependencies\"} == 0",
      "duration": "1m",
      "severity": "critical",
      "message": "Dependency {{source}} -> {{target}} is failing"
    }
  ],
  "scrapeConfigs": [
    {
      "jobName": "microservices",
      "scrapeInterval": "15s",
      "staticConfigs": [
        {
          "targets": [
            "gateway:8000",
            "user-account:8001",
            "game-catalog:8002",
            "booking:8003",
            "payment:8004",
            "rent:8005",
            "rating:8006"
          ],
          "labels": {
            "environment": "production",
            "monitoring": "enabled"
          }
        }
      ],
      "metricsPath": "/metrics"
    },
    {
      "jobName": "postgres",
      "scrapeInterval": "30s",
      "staticConfigs": [
        {
          "targets": [
            "user-account-db:9187",
            "game-catalog-db:9187",
            "rent-db:9187"
          ],
          "labels": {
            "environment": "production",
            "monitoring": "enabled"
          }
        }
      ]
    },
    {
      "jobName": "rabbitmq",
      "scrapeInterval": "30s",
      "staticConfigs": [
        {
          "targets": [
            "rabbitmq:15692"
          ],
          "labels": {
            "environment": "production",
            "monitoring": "enabled"
          }
        }
      ]
    }
  ],
  "logAggregation": {
    "enabled": true,
    "service": "loki",
    "retention": "30d",
    "labels": {
      "environment": "production",
      "application": "microservices"
    },
    "logLevels": [
      "error",
      "warn",
      "info",
      "debug"
    ]
  },
  "tracing": {
    "enabled": true,
    "service": "jaeger",
    "samplingRate": 0.1,
    "tags": {
      "environment": "production",
      "application": "microservices"
    }
  }
}
